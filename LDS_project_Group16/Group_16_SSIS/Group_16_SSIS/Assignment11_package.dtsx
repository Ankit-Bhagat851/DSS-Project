            <component
              refId="Package\Data Flow Task\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH main_songs AS (
    -- All main-role songs with their streams and date
    SELECT
        a.ID_artist,
        a.ID_artist_original AS ArtistName,
        f.ID_track_FK,
        f.streams_1month,
        t.year,
        t.month,
        t.day
    FROM dbo.fact_table AS f
    INNER JOIN dbo.track_artist_bridge AS b
        ON b.ID_track_FK = f.ID_track_FK
       AND b.role = 'main'
    INNER JOIN dbo.artist_dim AS a
        ON a.ID_artist = b.ID_artist_FK
    INNER JOIN dbo.time_dim AS t
        ON t.ID_time = f.ID_time_FK
),
first_song_per_artist AS (
    -- Determine each artist's first published main song (by date)
    SELECT ms.ID_artist,
           ms.ID_track_FK,
           ms.streams_1month,
           ROW_NUMBER() OVER (
             PARTITION BY ms.ID_artist
             ORDER BY ms.year, ms.month, ms.day
           ) AS rn
    FROM main_songs AS ms
),
artist_main_stats AS (
    -- Average, StdDev, Count of main songs per artist
    SELECT
        ms.ID_artist,
        AVG(CAST(ms.streams_1month AS FLOAT)) AS avg_streams,
        STDEV(CAST(ms.streams_1month AS FLOAT)) AS std_streams,
        COUNT(*) AS cnt_main
    FROM main_songs AS ms
    GROUP BY ms.ID_artist
),
global_baseline AS (
    -- Global average of first songs across artists
    SELECT
        AVG(CAST(fs.streams_1month AS FLOAT)) AS global_avg_first
    FROM first_song_per_artist AS fs
    WHERE fs.rn = 1
),
per_song_classification AS (
    -- Classify each main song as Trending/Flopping with edge-case rule
    SELECT
        ms.ID_artist,
        ms.ArtistName,
        ms.ID_track_FK,
        ms.streams_1month,
        s.avg_streams,
        s.std_streams,
        s.cnt_main,
        gb.global_avg_first,
        CASE
          WHEN s.cnt_main &gt; 1
               AND ms.streams_1month &gt;= (s.avg_streams + s.std_streams)
            THEN 1 ELSE
            CASE
              -- Edge case: only 1 main song → trending if &gt;= global avg of first songs (excluding itself is negligible)
              WHEN s.cnt_main = 1
                   AND ms.streams_1month &gt;= gb.global_avg_first
                THEN 1 ELSE 0
            END
        END AS IsTrending,
        CASE
          WHEN s.cnt_main &gt; 1
               AND ms.streams_1month &lt;= (s.avg_streams - s.std_streams)
            THEN 1 ELSE 0
        END AS IsFlopping
    FROM main_songs AS ms
    INNER JOIN artist_main_stats AS s
      ON s.ID_artist = ms.ID_artist
    CROSS JOIN global_baseline AS gb
),
per_artist_main AS (
    -- Aggregate counts and compute normalized factor + percentage
    SELECT
        ID_artist,
        MAX(ArtistName) AS ArtistName,
        SUM(IsTrending) AS TrendingCount,
        SUM(IsFlopping) AS FloppingCount,
        COUNT(*) AS TotalMainSongs,
        -- Trending Percentage: trending / total
        CASE WHEN COUNT(*) = 0 THEN 0.0
             ELSE CAST(SUM(IsTrending) AS FLOAT) / CAST(COUNT(*) AS FLOAT)
        END AS TrendingPercentage,
        -- Trending Factor normalized to [-1, 1]: (Trending - Flopping) / Total
        CASE WHEN COUNT(*) = 0 THEN 0.0
             ELSE CAST(SUM(IsTrending) - SUM(IsFlopping) AS FLOAT) / CAST(COUNT(*) AS FLOAT)
        END AS TrendingFactorNormalized
    FROM per_song_classification
    GROUP BY ID_artist
)
SELECT *
FROM per_artist_main;</property>
