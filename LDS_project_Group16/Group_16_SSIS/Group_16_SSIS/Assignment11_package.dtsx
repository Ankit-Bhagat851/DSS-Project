            <component
              refId="Package\Data Flow Task\OLE DB Source 1"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source 1"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH main_songs AS (
    SELECT
        a_main.ID_artist        AS MainArtistID,
        a_main.ID_artist_original AS MainArtistName,
        f.ID_track_FK           AS TrackID,
        f.streams_1month        AS Streams,
        t.year, t.month, t.day
    FROM dbo.fact_table AS f
    INNER JOIN dbo.track_artist_bridge AS b_main
        ON b_main.ID_track_FK = f.ID_track_FK AND b_main.role = 'main'
    INNER JOIN dbo.artist_dim AS a_main
        ON a_main.ID_artist = b_main.ID_artist_FK
    INNER JOIN dbo.time_dim AS t
        ON t.ID_time = f.ID_time_FK
),
artist_main_stats AS (
    SELECT
        MainArtistID,
        AVG(CAST(Streams AS FLOAT))  AS avg_streams,
        STDEV(CAST(Streams AS FLOAT)) AS std_streams,
        COUNT(*) AS cnt_main
    FROM main_songs
    GROUP BY MainArtistID
),
first_song_per_main AS (
    SELECT MainArtistID, TrackID, Streams,
           ROW_NUMBER() OVER (
             PARTITION BY MainArtistID
             ORDER BY year, month, day
           ) AS rn
    FROM main_songs
),
global_baseline AS (
    SELECT AVG(CAST(Streams AS FLOAT)) AS global_avg_first
    FROM first_song_per_main
    WHERE rn = 1
),
main_track_trend AS (
    -- Determine if EACH TRACK is trending/flopping for its MAIN artist
    SELECT
        ms.TrackID,
        ms.MainArtistID,
        CASE
          WHEN s.cnt_main &gt; 1
               AND ms.Streams &gt;= (s.avg_streams + s.std_streams)
            THEN 1
          WHEN s.cnt_main = 1
               AND ms.Streams &gt;= gb.global_avg_first
            THEN 1
          ELSE 0
        END AS IsTrendingForMain,
        CASE
          WHEN s.cnt_main &gt; 1
               AND ms.Streams &lt;= (s.avg_streams - s.std_streams)
            THEN 1
          ELSE 0
        END AS IsFloppingForMain
    FROM main_songs AS ms
    INNER JOIN artist_main_stats AS s
      ON s.MainArtistID = ms.MainArtistID
    CROSS JOIN global_baseline AS gb
),
featured_song_rows AS (
    -- For each TRACK, list all FEATURED artists on that track
    SELECT
        a_feat.ID_artist          AS FeaturedArtistID,
        a_feat.ID_artist_original AS FeaturedArtistName,
        mtt.TrackID,
        mtt.IsTrendingForMain,
        mtt.IsFloppingForMain
    FROM main_track_trend AS mtt
    INNER JOIN dbo.track_artist_bridge AS b_feat
      ON b_feat.ID_track_FK = mtt.TrackID
     AND b_feat.role = 'featured'
    INNER JOIN dbo.artist_dim AS a_feat
      ON a_feat.ID_artist = b_feat.ID_artist_FK
),
per_featured_artist AS (
    SELECT
        FeaturedArtistID,
        MAX(FeaturedArtistName) AS FeaturedArtistName,
        SUM(IsTrendingForMain)  AS TrendingCount,
        SUM(IsFloppingForMain)  AS FloppingCount,
        COUNT(*)                AS TotalFeaturedSongs,
        CASE WHEN COUNT(*) = 0 THEN 0.0
             ELSE CAST(SUM(IsTrendingForMain) AS FLOAT) / CAST(COUNT(*) AS FLOAT)
        END AS TrendingPercentage,
        CASE WHEN COUNT(*) = 0 THEN 0.0
             ELSE CAST(SUM(IsTrendingForMain) - SUM(IsFloppingForMain) AS FLOAT)
                  / CAST(COUNT(*) AS FLOAT)
        END AS TrendingFactorNormalized
    FROM featured_song_rows
    GROUP BY FeaturedArtistID
)
SELECT *
FROM per_featured_artist;</property>
