                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    tr.song_category,
    g.region,
    t.season,
    f.streams_1month
FROM dbo.fact_table AS f
INNER JOIN dbo.track_dim AS tr
    ON tr.ID_track = f.ID_track_FK
INNER JOIN dbo.track_artist_bridge AS b
    ON b.ID_track_FK = tr.ID_track
   AND b.role = 'main'      -- only main artist rows
INNER JOIN dbo.artist_dim AS a
    ON a.ID_artist = b.ID_artist_FK
INNER JOIN dbo.geo_dim AS g
    ON g.geo_ID = a.geo_ID_FK
INNER JOIN dbo.time_dim AS t
    ON t.ID_time = f.ID_time_FK;</property>
