                  <outputColumns>
                    <outputColumn
                      refId="Package\Data Flow Task\Derived Column.Outputs[Derived Column Output].Columns[IsEmerging]"
                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\Derived Column.Outputs[Derived Column Output].Columns[IsEmerging]"
                      name="IsEmerging"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[AvgStreams]} &lt; #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[GlobalAvgStreams]} &amp;&amp; #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[TrendingCount]} &gt; 0) ? 1 : 0</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(AvgStreams &lt; GlobalAvgStreams &amp;&amp; TrendingCount &gt; 0) ? 1 : 0</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Data Flow Task\Derived Column.Outputs[Derived Column Output].Columns[PotentialScore]"
                      dataType="r8"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\Derived Column.Outputs[Derived Column Output].Columns[PotentialScore]"
                      name="PotentialScore"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_R8)(#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[TrendingCount]} * (#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[GlobalAvgStreams]} - #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[AvgStreams]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_R8)(TrendingCount * (GlobalAvgStreams - AvgStreams))</property>
                      </properties>
                    </outputColumn>
