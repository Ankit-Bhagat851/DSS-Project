              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH main_songs AS (
    SELECT
        a.ID_artist,
        a.ID_artist_original AS ArtistName,
        f.streams_1month
    FROM dbo.fact_table AS f
    INNER JOIN dbo.track_artist_bridge AS b
        ON b.ID_track_FK = f.ID_track_FK AND b.role = 'main'
    INNER JOIN dbo.artist_dim AS a
        ON a.ID_artist = b.ID_artist_FK
),
artist_stats AS (
    SELECT
        ID_artist,
        MAX(ArtistName) AS ArtistName,
        AVG(CAST(streams_1month AS FLOAT)) AS AvgStreams,
        COUNT(*) AS SongCount
    FROM main_songs
    GROUP BY ID_artist
),
global_avg AS (
    SELECT AVG(CAST(streams_1month AS FLOAT)) AS GlobalAvgStreams
    FROM main_songs
),
trending_songs AS (
    SELECT
        ms.ID_artist,
        CASE WHEN ms.streams_1month &gt;= (s.AvgStreams + STDEV(CAST(ms.streams_1month AS FLOAT)) OVER (PARTITION BY ms.ID_artist))
             THEN 1 ELSE 0 END AS IsTrending
    FROM main_songs ms
    INNER JOIN artist_stats s ON s.ID_artist = ms.ID_artist
),
artist_trending AS (
    SELECT ID_artist, SUM(IsTrending) AS TrendingCount
    FROM trending_songs
    GROUP BY ID_artist
)
SELECT
    s.ID_artist,
    s.ArtistName,
    s.AvgStreams,
    s.SongCount,
    t.TrendingCount,
    g.GlobalAvgStreams
FROM artist_stats s
INNER JOIN artist_trending t ON s.ID_artist = t.ID_artist
CROSS JOIN global_avg g;</property>
